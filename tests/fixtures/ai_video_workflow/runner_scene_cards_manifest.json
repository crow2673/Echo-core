      ],
      "outputs": ["memory/media_workflows/1thjcus_scene_cards/work/quality/quality_report.json"],
      "dependencies": ["assemble_video"],
      "handler": "quality_check",
      "retryable": true,
      "human_review_required": true
    },
    {
      "stage_id": "export",
      "status": "pending",
      "inputs": [
        "memory/media_workflows/1thjcus_scene_cards/work/video/segment.raw.mp4",

      "outputs": ["memory/media_workflows/1thjcus_scene_cards/work/video/segment.raw.mp4"],
      "dependencies": ["generate_placeholder_audio", "generate_placeholder_visual", "generate_captions"],
      "handler": "assemble_video",
      "retryable": true,
      "human_review_required": true
